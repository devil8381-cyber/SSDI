# ── Server (Netlify env vars — set these in Netlify UI → Site settings → Environment) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte hex key used to encrypt SMTP passwords & Drive/Meta secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Any random string — must match what you enter in the Meta webhook config
META_VERIFY_TOKEN=

# ── Frontend (Netlify env vars too — Vite bakes them into the build) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
