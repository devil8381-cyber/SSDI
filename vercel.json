{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "api/index.js", "use": "@vercel/node", "config": { "maxDuration": 60 } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js", "headers": { "x-original-path": "/api/$1" } },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(favicon\\.ico|vite\\.svg|robots\\.txt)$", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily-digest", "schedule": "0 13 * * *" },
    { "path": "/api/cron/sheets-sync", "schedule": "0 13 * * *" }
  ]
}
